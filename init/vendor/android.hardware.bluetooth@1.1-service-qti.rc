service vendor.bluetooth-1-1-qti /vendor/bin/hw/android.hardware.bluetooth@1.1-service-qti
    interface android.hardware.bluetooth@1.1::IBluetoothHci default
    interface android.hardware.bluetooth@1.0::IBluetoothHci default
    class hal
    user bluetooth
    group bluetooth system wakelock oem_2901 net_raw oem_2912
